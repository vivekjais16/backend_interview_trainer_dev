# ==============================================================
# AI Backend & MNC Interview Trainer - Configuration
# ==============================================================

# Application
APP_NAME="AI Python Backend & MNC Interview Trainer"
APP_ENV=development
DEBUG=True
PORT=8000
HOST=0.0.0.0

# Database Configuration (MySQL default with automatic SQLite fallback)
# For MySQL: mysql+pymysql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=mysql+pymysql://root:rootpassword@localhost:3306/interview_trainer
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_AUTO_FALLBACK_SQLITE=True

# GenAI Engine Configuration
# Available AI Providers: "mock", "gemini", "openai", "ollama"
AI_PROVIDER=mock
GEMINI_API_KEY=""
OPENAI_API_KEY=""
OLLAMA_BASE_URL="http://localhost:11434"
AI_MODEL_NAME="gemini-1.5-flash"

# Sandbox Limits
CODE_EXECUTION_TIMEOUT_SECONDS=5
MAX_EXECUTION_MEMORY_MB=128
SQL_MAX_ROWS=100
